# Copy to `.env` and adjust. Every variable must be prefixed with EXPO_PUBLIC_
# to be readable from the app bundle. Never put a secret here — EXPO_PUBLIC_
# values are embedded in the shipped JavaScript bundle and are readable by anyone.
#
# Read these through `src/config/env.ts` only. Do not use `process.env` elsewhere.

# Base URL of the NestJS API. The `/v1` prefix is added by the Axios client.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Socket.IO server URL (trip tracking + conversations).
EXPO_PUBLIC_WS_URL=http://localhost:3000

# Serve every request from local fixtures instead of the network.
EXPO_PUBLIC_ENABLE_MOCK_API=true

# Expose development-only routes and debug affordances.
EXPO_PUBLIC_ENABLE_DEV_ROUTES=true

# Start the app already authenticated with a fake session. Development only.
# Must stay `false` in any build that talks to a real backend.
EXPO_PUBLIC_DEV_AUTH_MODE=false

# --- Google Maps keys (client / public) -------------------------------------
# WEB map (src/services/maps/MapView.tsx) — Google Maps JavaScript API key.
# Restrict by HTTP referrer + to "Maps JavaScript API". Empty ⇒ MapPlaceholder.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# NATIVE map — only used in a dev/prod build (`eas build` / prebuild); Expo Go
# renders the map with NO key (Android → Google via Expo's key, iOS → Apple).
# Restrict by Android package + SHA-1 / iOS bundle id. NOT the backend key.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
