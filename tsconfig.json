{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    // Metro's `tsconfigPaths` support resolves `@/` from `baseUrl` + `paths`.
    // A later TypeScript deprecates `baseUrl`; keep it until Metro no longer
    // needs it. `"6.0"` is the accepted value on the TS 6.0 line this SDK pins.
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["jest", "node"]
  },
  // `.expo/types/router.d.ts` is generated by `expo start` and is what makes
  // typed routes real. It must be included, so `.expo` cannot be excluded —
  // `exclude` wins over `include`.
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
